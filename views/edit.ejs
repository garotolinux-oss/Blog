<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!--Barra superos-->
    <div class="barra">
        <nav id="nav_sup">
            <a href=""><img src="" alt="img" id="a_sup"></a>
            <a href="index.ejs" id="a_sup">Inicio</a>
            <a href="create_page.ejs" id="a_sup">Criar</a>
            <a href="edit.ejs" id="a_sup">edita/deletar</a>
        </nav>
    </div>
    
    <!--titulo-->
    <div id="main" >
        <h1 id="titulo">Blog Ribeiro</h1>
    </div>

    <!--postages geradas pela lista-->

    <div id="container_posts">
    <% if (typeof blogs !== 'undefined' && blogs.length > 0) { %>
    <% blogs.forEach(element => { %>
        <div class = "posts_style">
            <div class="inline_post_top">
                <h3><%=element.titulo_in%> </h3>
                
                <button type="button" class="pen btn"><a href="create_page.ejs">edita</a>></button>
                <button type="button" class="remove btn" ><a href="create_page.ejs">remove</a></button>
            </div>
            
                <p><%=element.corpo%></p>
       </div>
    <% }); } else { %>
     <div class = "posts_style" style="visibility: hidden;">
            <h3></h3>
            <p></p>
      <% } %> </div>
    </div>

    <!--rodapé-->
    <div id="nav_inf" class="barra">

    </div>
    
</body>
</html>