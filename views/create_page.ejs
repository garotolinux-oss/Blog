<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
     
    <div class="barra">
        <nav id="nav_sup">
            <a href="" id="a_sup">Blog</a>
            <a href="index.ejs" id="a_sup">Inicio</a>
            <a href="create_page.ejs" id="a_sup">Criar</a>
            <a href="edit.ejs" id="a_sup">edita/deletar</a>
        </nav>
    </div>

    
    
    <div id="main_principal">
    
        <div id="main" >
        <h1 id="titulo">Crie seu post</h1>
        
       
   
    </div>

    <div id="form">
    <% 
       // Define as variáveis de controle para evitar erros de 'undefined'
       const rotaAction = (typeof post !== 'undefined') ? '/update-post/' + post.titulo_in : '/submit';
       const valorTitulo = (typeof post !== 'undefined') ? post.titulo_in : '';
       const valorCorpo = (typeof post !== 'undefined') ? post.corpo : '';
       const textoBotao = (typeof post !== 'undefined') ? 'Salvar Alterações' : 'Enviar';
    %>

    <form action="<%= rotaAction %>" method="post">
        <label for="titulo_in">Titulo</label>
        <input type="text" id="titulo_in" name="titulo_in" value="<%= valorTitulo %>" required>

        <label for="corpo">Conteúdo</label>
        <!-- Usei textarea para o corpo, pois geralmente postagens são longas -->
        <textarea id="corpo" name="corpo" required><%= valorCorpo %></textarea>

        <input type="submit" value="<%= textoBotao %>" id="form_button">
    </form>
</div>


    </div>
   
    
    <div id="nav_inf" class="barra">

    </div>
</body>
</html>